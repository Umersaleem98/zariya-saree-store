DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zariya_store
# Hosted MySQL: require TLS and paste the service CA PEM with literal \n separators.
DB_SSL=false
DB_SSL_CA=
# Used only by npm run db:setup. Choose your own credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
APP_URL=http://127.0.0.1:3000
# Optional: create a Web OAuth client in Google Cloud Console.
# Redirect URI: http://127.0.0.1:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
